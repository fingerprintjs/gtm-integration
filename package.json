{
  "name": "@fingerprint/gtm-adapter",
  "version": "2.0.0",
  "description": "Fingerprint JS agent adapter for Google Tag Manager",
  "author": "FingerprintJS, Inc (https://fingerprint.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/gtm-integration.git"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c --bundleConfigAsCjs",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm lint --fix",
    "test:dts": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:diff": "vitest run --coverage --reporter json --outputFile.json=report.json",
    "prepare": "husky",
    "changeset:version": "changeset version",
    "changeset:publish": "HUSKY=0 changeset publish"
  },
  "module": "dist/fp-gtm-adapter.esm.js",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.0.2",
    "@fingerprintjs/eslint-config-dx-team": "^3.1.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.1.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^24.12.4",
    "@vitest/coverage-istanbul": "^4.1.8",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "rollup": "^4.61.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@fingerprint/agent": "^4.1.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
